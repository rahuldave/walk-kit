# The class material for @project@: the notes with your private cues, the slides, and the recipes that use
# them. Run `just` to see the list, and `just setup` first on a new machine. The scripts behind walk-init,
# walk-update and check-pdf are the walk skill's: https://github.com/rahuldave/walk-kit
#
# The project and the walk repository are found beside this folder, as ../@project@ and ../@project@-walk,
# unless PROJECT_DIR and WALK_DIR name other folders. WALK_SKILL names the skill, if it is not in ~/.agents/skills.

project := "@project@"
upstream := "@upstream@"
# timewalk is not pinned: each run fetches the newest. TIMEWALK names another source, a working copy say
timewalk := env("TIMEWALK", "@timewalk@")
repo := env("PROJECT_DIR", @repo_default@)
walk := env("WALK_DIR", @walk_default@)
skill := env("WALK_SKILL", home_directory() / ".agents/skills/walk")

[private]
default:
    @just --list --unsorted

# Get what the class needs: the project beside this folder, with its step tags, and @project@-walk. Says if the skill is missing
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes"
    for tool in uv git python3; do
        command -v "$tool" > /dev/null || { echo "setup: $tool is not on this machine" >&2; exit 1; }
    done
    # Clone over ssh, so that you can push; over https if you have no ssh key for GitHub
    clone() {
        echo "setup: cloning github.com/{{ upstream }}/$1 into $2"
        git clone --quiet "git@github.com:{{ upstream }}/$1.git" "$2" 2> /dev/null \
            || git clone --quiet "https://github.com/{{ upstream }}/$1.git" "$2"
    }
    if [ ! -d "{{ repo }}/.git" ]; then clone "{{ project }}" "{{ repo }}"; fi
    echo "setup: the project is {{ repo }}, with $(git -C "{{ repo }}" tag -l 'step-*' | wc -l | tr -d ' ') steps"
    if [ ! -d "{{ walk }}/.git" ]; then
        if git ls-remote --exit-code "https://github.com/{{ upstream }}/{{ project }}-walk.git" HEAD > /dev/null 2>&1; then
            clone "{{ project }}-walk" "{{ walk }}"
        else
            echo "setup: there is no @project@-walk yet; just walk-init makes it"
        fi
    fi
    if [ -d "{{ walk }}/.git" ]; then echo "setup: the walk repository is {{ walk }}"; fi
    if [ -f "{{ skill }}/scripts/common.py" ]; then
        echo "setup: the walk skill is {{ skill }}"
    else
        echo "setup: the walk skill is not installed. walk-init, walk-update and check-pdf need it. Install it with:"
        echo "  git clone https://github.com/rahuldave/walk-kit ~/Projects/walk-kit"
        echo "  mkdir -p ~/.agents/skills && ln -s ~/Projects/walk-kit ~/.agents/skills/walk"
    fi

# Open the walk on the project with these notes and slides, the clock on. Prints the address to open
present *args: setup
    #!/usr/bin/env bash
    set -euo pipefail
    slides=()
    if [ -f slides/slides.toml ]; then slides=(--slides slides/slides.toml); fi
    uvx --refresh-package timewalk --from "{{ timewalk }}" timewalk "{{ repo }}" --notes notes.md ${slides[@]+"${slides[@]}"} --discard-edits --clock {{ args }}

# Make the PDF, build/PROJECT.pdf: the slides, one page each. The notes are for the step browser, `just present`, and are not in it.
# BRAND=brand/NAME just pdf gives it the look of a brand folder: a brand.toml, a logo and fonts. Without BRAND, no brand
pdf:
    #!/usr/bin/env bash
    set -euo pipefail
    test -f slides/slides.toml || { echo "pdf: there are no slides; the notes are for the step browser: just present" >&2; exit 1; }
    mkdir -p build
    brand=()
    if [ -n "${BRAND:-}" ]; then test -e "$BRAND" || { echo "pdf: BRAND=$BRAND does not exist" >&2; exit 1; }; brand=(--brand "$BRAND"); fi
    uvx --refresh-package timewalk --from "{{ timewalk }}" timewalk-pdf slides/slides.toml --notes notes.md --title "{{ project }}" ${brand[@]+"${brand[@]}"} -o "build/{{ project }}.pdf"

# Check that no slide is cut off in the PDF: the last words of every slide must be in its text
check-pdf:
    #!/usr/bin/env bash
    set -euo pipefail
    test -f "{{ skill }}/scripts/pdf_check.py" || { echo "check-pdf: the walk skill is not installed; just setup says how" >&2; exit 1; }
    python3 "{{ skill }}/scripts/pdf_check.py" "build/{{ project }}.pdf" --class .

# Make @project@-walk, the repository that students fork. Asks before it creates the repository on GitHub
walk-init *args:
    #!/usr/bin/env bash
    set -euo pipefail
    test -f "{{ skill }}/scripts/common.py" || { echo "walk-init: the walk skill is not installed; just setup says how" >&2; exit 1; }
    python3 "{{ skill }}/scripts/walk_init.py" --project "{{ project }}" --upstream "{{ upstream }}" --walk "{{ walk }}" {{ args }}

# Refresh @project@-walk from notes.md, without the private cues, and from slides/. Shows the diff, and commits on a yes
walk-update *args:
    #!/usr/bin/env bash
    set -euo pipefail
    test -f "{{ skill }}/scripts/common.py" || { echo "walk-update: the walk skill is not installed; just setup says how" >&2; exit 1; }
    slides=()
    if [ -f slides/slides.toml ]; then slides=(--slides slides); fi
    python3 "{{ skill }}/scripts/walk_update.py" --project "{{ project }}" --notes notes.md --walk "{{ walk }}" ${slides[@]+"${slides[@]}"} {{ args }}
