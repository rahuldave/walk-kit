# The class material for @project@: the notes with your private cues, the slides, and the recipes that use
# them. Run `just` to see the list, and `just setup` first on a new machine. The scripts behind walk-init,
# walk-update and student-pdf are the walk skill's: https://github.com/rahuldave/walk-kit
#
# The project and the kit are found beside this folder, as ../@project@ and ../@project@-walk, unless
# WALK_REPO and WALK_KIT name other folders. WALK_SKILL names the skill, if it is not in ~/.agents/skills.

project := "@project@"
upstream := "@upstream@"
timewalk := "@timewalk@"
repo := env("WALK_REPO", @repo_default@)
kit := env("WALK_KIT", @kit_default@)
skill := env("WALK_SKILL", home_directory() / ".agents/skills/walk")

[private]
default:
    @just --list --unsorted

# Get what the class needs: the project beside this folder, with its step tags, and the kit. Says if the skill is missing
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes"
    for tool in uv git python3; do
        command -v "$tool" > /dev/null || { echo "setup: $tool is not on this machine" >&2; exit 1; }
    done
    # Clone over ssh, so that you can push; over https if you have no ssh key for GitHub
    clone() {
        echo "setup: cloning github.com/{{ upstream }}/$1 into $2"
        git clone --quiet "git@github.com:{{ upstream }}/$1.git" "$2" 2> /dev/null \
            || git clone --quiet "https://github.com/{{ upstream }}/$1.git" "$2"
    }
    if [ ! -d "{{ repo }}/.git" ]; then clone "{{ project }}" "{{ repo }}"; fi
    echo "setup: the project is {{ repo }}, with $(git -C "{{ repo }}" tag -l 'step-*' | wc -l | tr -d ' ') steps"
    if [ ! -d "{{ kit }}/.git" ]; then
        if git ls-remote --exit-code "https://github.com/{{ upstream }}/{{ project }}-walk.git" HEAD > /dev/null 2>&1; then
            clone "{{ project }}-walk" "{{ kit }}"
        else
            echo "setup: there is no kit yet; just walk-init makes one"
        fi
    fi
    if [ -d "{{ kit }}/.git" ]; then echo "setup: the kit is {{ kit }}"; fi
    if [ -f "{{ skill }}/scripts/common.py" ]; then
        echo "setup: the walk skill is {{ skill }}"
    else
        echo "setup: the walk skill is not installed. walk-init, walk-update and student-pdf need it. Install it with:"
        echo "  git clone https://github.com/rahuldave/walk-kit ~/Projects/walk-kit"
        echo "  mkdir -p ~/.agents/skills && ln -s ~/Projects/walk-kit ~/.agents/skills/walk"
    fi

# Open the walk on the project with these notes and slides, the clock on. Prints the address to open
present *args: setup
    #!/usr/bin/env bash
    set -euo pipefail
    slides=()
    if [ -f slides/slides.toml ]; then slides=(--slides slides/slides.toml); fi
    uvx --from "{{ timewalk }}" timewalk "{{ repo }}" --notes notes.md ${slides[@]+"${slides[@]}"} --discard-edits --clock {{ args }}

# Make your handout, build/PROJECT-handout.pdf: the slides, with the notes of each step after them, your cues included
handout:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p build
    slides=()
    if [ -f slides/slides.toml ]; then slides=(slides/slides.toml); fi
    uvx --from "{{ timewalk }}" timewalk-pdf ${slides[@]+"${slides[@]}"} --notes notes.md --with-notes --title "{{ project }}" -o "build/{{ project }}-handout.pdf"

# Make the students' PDF, build/PROJECT-student.pdf: the slides and the notes, without your private cues
student-pdf:
    #!/usr/bin/env bash
    set -euo pipefail
    test -f "{{ skill }}/scripts/common.py" || { echo "student-pdf: the walk skill is not installed; just setup says how" >&2; exit 1; }
    slides=()
    if [ -f slides/slides.toml ]; then slides=(--slides slides); fi
    python3 "{{ skill }}/scripts/student_pdf.py" --project "{{ project }}" --notes notes.md ${slides[@]+"${slides[@]}"} --out "build/{{ project }}-student.pdf"

# Make the walk kit for students, a new repository. Asks before it creates the repository on GitHub
walk-init *args:
    #!/usr/bin/env bash
    set -euo pipefail
    test -f "{{ skill }}/scripts/common.py" || { echo "walk-init: the walk skill is not installed; just setup says how" >&2; exit 1; }
    python3 "{{ skill }}/scripts/walk_init.py" --project "{{ project }}" --upstream "{{ upstream }}" --kit "{{ kit }}" {{ args }}

# Refresh the kit from notes.md, without the private cues. Shows the diff, and commits on a yes. Add --slides slides
walk-update *args:
    #!/usr/bin/env bash
    set -euo pipefail
    test -f "{{ skill }}/scripts/common.py" || { echo "walk-update: the walk skill is not installed; just setup says how" >&2; exit 1; }
    python3 "{{ skill }}/scripts/walk_update.py" --project "{{ project }}" --notes notes.md --kit "{{ kit }}" {{ args }}
